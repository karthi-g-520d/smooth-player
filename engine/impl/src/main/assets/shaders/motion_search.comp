#version 310 es
// Full-search block matching on luma: the GPU form of estimateMotion in MotionSearch.kt, which defines the result.
// Change the two together. The defines (block size, search range, bindings, locations) come from GpuMotionSearch.kt.
//
// One work group per block. Blocks are dispatched one wavefront at a time (bx + 2 * by == u_wave), so a block's left,
// upper and upper-right neighbours are already written when it reads them for its predictor, as in the CPU's raster
// order. The previous frame's search area and the next frame's block are loaded into shared memory once. Each
// invocation then scores a share of the candidate vectors, and an atomicMin on (cost, candidate index) keeps the
// cheapest, with ties going to the first candidate in raster order, as on the CPU.
//
// IN : u_prevLuma, u_nextLuma (R8 luma), u_planeSize (luma size in pixels), u_grid (block columns and rows),
//      u_wave, u_firstRow (the wavefront and its first block row), b_raw (neighbours from earlier wavefronts)
// OUT: b_raw[block] = integer vector, subpixel offset and residual, before the median filter
precision highp float;
precision highp int;

layout(local_size_x = SEARCH_WORKGROUP_SIZE) in;

#define TILE_MARGIN (SEARCH_RANGE + 1)
#define TILE_SIDE (BLOCK_SIZE + 2 * TILE_MARGIN)
#define CANDIDATE_SIDE (2 * SEARCH_RANGE + 1)
#define CANDIDATE_COUNT (CANDIDATE_SIDE * CANDIDATE_SIDE)
#define BLOCK_PIXELS (BLOCK_SIZE * BLOCK_SIZE)
#define FIT_SAMPLES 5

struct Block {
    ivec2 vector;
    vec2 subpixel;
    float residual;
    float pad;
};

layout(binding = BINDING_PREV_LUMA) uniform highp sampler2D u_prevLuma;
layout(binding = BINDING_NEXT_LUMA) uniform highp sampler2D u_nextLuma;
layout(std430, binding = BINDING_RAW_FIELD) buffer RawField { Block b_raw[]; };
layout(location = LOC_PLANE_SIZE) uniform ivec2 u_planeSize;
layout(location = LOC_GRID) uniform ivec2 u_grid;
layout(location = LOC_WAVE) uniform int u_wave;
layout(location = LOC_FIRST_ROW) uniform int u_firstRow;

// The previous frame around the block, with one extra pixel of margin for the subpixel fit at the range's edge.
shared int s_prev[TILE_SIDE * TILE_SIDE];
shared int s_next[BLOCK_PIXELS];
shared uint s_best;
shared ivec2 s_predictor;
shared int s_fitSad[FIT_SAMPLES];

// The best vector itself, then its left, right, upper and lower neighbours, for the parabola fit.
const ivec2 FIT_OFFSETS[FIT_SAMPLES] = ivec2[FIT_SAMPLES](
    ivec2(0, 0), ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1));
const float HALF_PIXEL = 0.5;
const float MAX_LUMA = 255.0;

// Reads clamp to the nearest edge pixel, like LumaPlane.at.
int prevAt(ivec2 p) {
    return int(round(texelFetch(u_prevLuma, clamp(p, ivec2(0), u_planeSize - 1), 0).r * MAX_LUMA));
}

int nextAt(ivec2 p) {
    return int(round(texelFetch(u_nextLuma, clamp(p, ivec2(0), u_planeSize - 1), 0).r * MAX_LUMA));
}

// Median of the causal neighbours that exist, taken as the CPU does: sort them and pick index count / 2.
int medianOfNeighbours(int values[3], int count) {
    if (count == 0) return 0;
    if (count == 1) return values[0];
    if (count == 2) return max(values[0], values[1]);
    return max(min(values[0], values[1]), min(max(values[0], values[1]), values[2]));
}

ivec2 predictor(int bx, int by) {
    int xs[3];
    int ys[3];
    int count = 0;
    if (bx > 0) {
        ivec2 v = b_raw[by * u_grid.x + bx - 1].vector;
        xs[count] = v.x;
        ys[count] = v.y;
        count++;
    }
    if (by > 0) {
        ivec2 v = b_raw[(by - 1) * u_grid.x + bx].vector;
        xs[count] = v.x;
        ys[count] = v.y;
        count++;
    }
    if (by > 0 && bx + 1 < u_grid.x) {
        ivec2 v = b_raw[(by - 1) * u_grid.x + bx + 1].vector;
        xs[count] = v.x;
        ys[count] = v.y;
        count++;
    }
    return ivec2(medianOfNeighbours(xs, count), medianOfNeighbours(ys, count));
}

// SAD of the block's in-plane pixels against the previous frame displaced by v: next(p) against prev(p - v).
int candidateSad(ivec2 v, ivec2 valid) {
    int sum = 0;
    for (int py = 0; py < valid.y; py++) {
        for (int px = 0; px < valid.x; px++) {
            int prev = s_prev[(py - v.y + TILE_MARGIN) * TILE_SIDE + (px - v.x + TILE_MARGIN)];
            sum += abs(s_next[py * BLOCK_SIZE + px] - prev);
        }
    }
    return sum;
}

// Sum of absolute deviations from the block mean, in the CPU's order so the float sums agree.
float blockDetail(ivec2 valid) {
    int total = 0;
    for (int py = 0; py < valid.y; py++) {
        for (int px = 0; px < valid.x; px++) {
            total += s_next[py * BLOCK_SIZE + px];
        }
    }
    float mean = float(total) / float(valid.x * valid.y);
    float detail = 0.0;
    for (int py = 0; py < valid.y; py++) {
        for (int px = 0; px < valid.x; px++) {
            detail += abs(float(s_next[py * BLOCK_SIZE + px]) - mean);
        }
    }
    return detail;
}

// Same rules as subpixelOffset in MotionSearch.kt: zero for an exact match or when the samples are not a minimum.
float subpixelOffset(int before, int centre, int after) {
    if (centre == 0) return 0.0;
    int curvature = before - 2 * centre + after;
    if (curvature <= 0) return 0.0;
    return clamp(HALF_PIXEL * float(before - after) / float(curvature), -HALF_PIXEL, HALF_PIXEL);
}

void main() {
    int by = u_firstRow + int(gl_WorkGroupID.x);
    int bx = u_wave - 2 * by;
    ivec2 origin = ivec2(bx, by) * BLOCK_SIZE;
    // Blocks on the right and bottom edges can hang off the plane. Only their in-plane pixels count.
    ivec2 valid = min(ivec2(BLOCK_SIZE), u_planeSize - origin);
    int lane = int(gl_LocalInvocationIndex);

    if (lane == 0) {
        s_best = 0xFFFFFFFFu;
        s_predictor = predictor(bx, by);
    }
    ivec2 tileOrigin = origin - TILE_MARGIN;
    for (int i = lane; i < TILE_SIDE * TILE_SIDE; i += SEARCH_WORKGROUP_SIZE) {
        s_prev[i] = prevAt(tileOrigin + ivec2(i % TILE_SIDE, i / TILE_SIDE));
    }
    for (int i = lane; i < BLOCK_PIXELS; i += SEARCH_WORKGROUP_SIZE) {
        s_next[i] = nextAt(origin + ivec2(i % BLOCK_SIZE, i / BLOCK_SIZE));
    }
    memoryBarrierShared();
    barrier();

    ivec2 pred = s_predictor;
    for (int c = lane; c < CANDIDATE_COUNT; c += SEARCH_WORKGROUP_SIZE) {
        ivec2 v = ivec2(c % CANDIDATE_SIDE, c / CANDIDATE_SIDE) - SEARCH_RANGE;
        int penalty = SMOOTHNESS_WEIGHT * (abs(v.x - pred.x) + abs(v.y - pred.y));
        uint cost = uint(candidateSad(v, valid) + penalty);
        atomicMin(s_best, (cost << CANDIDATE_BITS) | uint(c));
    }
    memoryBarrierShared();
    barrier();

    int candidate = int(s_best & ((1u << CANDIDATE_BITS) - 1u));
    ivec2 best = ivec2(candidate % CANDIDATE_SIDE, candidate / CANDIDATE_SIDE) - SEARCH_RANGE;
    if (lane < FIT_SAMPLES) {
        s_fitSad[lane] = candidateSad(best + FIT_OFFSETS[lane], valid);
    }
    memoryBarrierShared();
    barrier();

    if (lane == 0) {
        int centre = s_fitSad[0];
        Block result;
        result.vector = best;
        result.subpixel = vec2(
            subpixelOffset(s_fitSad[1], centre, s_fitSad[2]),
            subpixelOffset(s_fitSad[3], centre, s_fitSad[4]));
        result.residual = float(centre) / (blockDetail(valid) + 1.0);
        result.pad = 0.0;
        b_raw[by * u_grid.x + bx] = result;
    }
}
